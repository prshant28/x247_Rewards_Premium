# ═══════════════════════════════════════════════════════
#   X247 Rewards — Environment Configuration
#   Copy this file → rename to .env → fill in the values
#   ⚠️  Never commit .env to GitHub
# ═══════════════════════════════════════════════════════


# ── DATABASE ──────────────────────────────────────────
#
# Supabase PostgreSQL connection string
# Where to find: Supabase Dashboard → Project Settings
#                → Database → Connection string → URI
#                (Use "Transaction pooler" for Hostinger/serverless)
#
DATABASE_URL=postgresql://postgres.XXXX:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres


# ── SUPABASE STORAGE (Screenshot Uploads) ─────────────
#
# Where to find: Supabase Dashboard → Project Settings → API
#
# Project URL (looks like https://xxxx.supabase.co)
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co

# Service role secret key  ← use service_role, NOT anon key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXX

# Bucket name (must match what you created in Supabase Storage)
SUPABASE_STORAGE_BUCKET=uploads


# ── AI CHATBOT ────────────────────────────────────────
#
# OpenRouter API key — free tier available
# Where to get: https://openrouter.ai → Sign up → API Keys → Create key
#
OPENROUTER_API_KEY=sk-or-v1-XXXX


# ── SERVER ────────────────────────────────────────────
#
# Deployment environment
NODE_ENV=production

# Port (Hostinger sets this automatically — no need to change)
PORT=8080

# Session secret — any long random string (32+ characters)
# Generate one: https://generate-secret.vercel.app/64
SESSION_SECRET=replace-this-with-a-long-random-string-minimum-32-chars

# Log level (optional) — error | warn | info | debug
LOG_LEVEL=info


# ═══════════════════════════════════════════════════════
#   The following are SET AUTOMATICALLY by Replit.
#   Do NOT set these manually when deploying outside Replit.
#
#   AI_INTEGRATIONS_OPENROUTER_BASE_URL  ← Replit only
#   AI_INTEGRATIONS_OPENROUTER_API_KEY   ← Replit only (use OPENROUTER_API_KEY instead)
#   BASE_PATH                            ← Replit only
#   REPL_ID                              ← Replit only
# ═══════════════════════════════════════════════════════
