# ─────────────────────────────────────────────
#  X247 Rewards — Environment Variables
#  Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
# PostgreSQL connection string (Supabase, Neon, Railway, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── Server ────────────────────────────────────
# Port the API server listens on (Hostinger sets this automatically)
PORT=8080

# Secret key for signing session tokens (any random 32+ char string)
SESSION_SECRET=change-this-to-a-long-random-secret-string

# ── AI Chatbot (OpenRouter) ───────────────────
# Get a free API key at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-...

# ── Object Storage (Screenshot Uploads) ──────
# Only needed if you want file uploads to work
# Set up a Google Cloud Storage bucket and fill these in
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=your-bucket-id
# PRIVATE_OBJECT_DIR=/your-bucket/private
# PUBLIC_OBJECT_SEARCH_PATHS=/your-bucket/public

# ── Build (set automatically on most platforms) ──
# NODE_ENV=production
