# ═══════════════════════════════════════════════════════
#   X247 Rewards — Environment Configuration
#   Copy this file → rename to .env → fill in the values
#   ⚠️  Never commit .env to GitHub
# ═══════════════════════════════════════════════════════


# ── DATABASE ──────────────────────────────────────────
#
# Neon PostgreSQL connection string (via Replit, or your own Neon account)
# Get it from: https://neon.tech → Project → Connection Details
#
DATABASE_URL=postgresql://user:password@host/database?sslmode=require


# ── OBJECT STORAGE (Screenshot Uploads) ───────────────
#
# Provided automatically by Replit Object Storage.
# On Hostinger/external: use your own GCS bucket or swap
# the objectStorage.ts implementation for S3-compatible storage.
#
DEFAULT_OBJECT_STORAGE_BUCKET_ID=your-bucket-id
PRIVATE_OBJECT_DIR=/your-bucket-id/private
PUBLIC_OBJECT_SEARCH_PATHS=/your-bucket-id/public


# ── AI CHATBOT ────────────────────────────────────────
#
# OpenRouter API key — free tier available
# Where to get: https://openrouter.ai → Sign up → API Keys → Create key
#
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key


# ── SERVER ────────────────────────────────────────────
#
# Deployment environment
NODE_ENV=production

# Port (Hostinger sets this automatically — no need to change)

# Session secret — any long random string (32+ characters)
# Generate one: https://generate-secret.vercel.app/64
SESSION_SECRET=replace-this-with-a-long-random-string-minimum-32-chars

# Log level (optional) — error | warn | info | debug
LOG_LEVEL=info


# ═══════════════════════════════════════════════════════
#   Hostinger Deployment Build Command:
#   npm install -g pnpm && pnpm install && pnpm run build
#
#   Entry Point:  artifacts/api-server/dist/index.mjs
#   Static Files: artifacts/x247-rewards/dist/public
#   Port:         8080
#
#   The server auto-seeds the database on first boot.
#   Schema columns are added automatically if missing.
#   No manual DB push needed for standard deployments.
# ═══════════════════════════════════════════════════════
