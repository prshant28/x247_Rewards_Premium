modules = ["nodejs-24", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["elevenlabs:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 80

[[ports]]
localPort = 18298
externalPort = 3002

[[ports]]
localPort = 19295
externalPort = 3003

[[ports]]
localPort = 26167
externalPort = 3001

[[ports]]
localPort = 26168
externalPort = 3000

[nix]
channel = "stable-25_05"

[objectStorage]
defaultBucketID = "replit-objstore-ba74a24d-d922-4a5b-bab3-30f1748ae509"

[userenv]

[userenv.shared]
VAPID_PUBLIC_KEY = "BBuKIc4qPwx7gSxfOllqNoZhU2hMs2JkD6FIVmB64kdsjVxsi2tMrSenmlf9gym8G902xWIvJWX-0YfQB2bgYiM"
